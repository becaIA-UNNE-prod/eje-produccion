# Datos y entorno operativo existentes
/dataset
/mascaras_procesadas
/pesos
/.venv

# Salidas por corrida: solo versionar el índice
/artifacts/*
!/artifacts/README.md

# Evitar que vuelvan a versionarse salidas sueltas en la raíz
/*.png
/*.tif
/*.log
/*.out
/logs.txt
/estructura_sentinel2.json
/baseline_sin_2017/
/previo_20260918_mesesmal/
/resultados_test_actual_comparacion_*/
*.bak

# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Entradas físicas en /mnt; aliases locales y TIFF fuera de Git
/data/

# Mapas navegables livianos distribuidos con Git
!/artifacts/maps/
/artifacts/maps/**
!/artifacts/maps/**/
!/artifacts/maps/**/*.html
!/artifacts/maps/**/*.json
!/artifacts/maps/**/*.geojson

# Copias de revisión: reportes, figuras y métricas del mirror
!/artifacts/reports/
/artifacts/reports/**
!/artifacts/reports/**/
!/artifacts/reports/**/*.csv
!/artifacts/reports/**/*.geojson
!/artifacts/reports/**/*.html
!/artifacts/reports/**/*.json
!/artifacts/reports/**/*.md
!/artifacts/reports/**/*.png
!/artifacts/reports/**/*.py
!/artifacts/reports/**/*.svg
!/artifacts/reports/**/*.txt
/artifacts/reports/test_actual
/artifacts/reports/**/logs/
